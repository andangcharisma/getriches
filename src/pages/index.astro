---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const features = [
	{ title: 'Track spending', text: 'Log every expense in seconds and see where your money goes.' },
	{ title: 'Smart budgets', text: 'Set monthly budgets per category and stay on target.' },
	{ title: 'Grow your wealth', text: 'Watch your net worth and savings progress over time.' },
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${SITE_TITLE} – Personal finance, simplified`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<h1>Take control of your money with Riches</h1>
				<p>{SITE_DESCRIPTION}</p>
				<!-- TODO: replace with real App Store / Google Play links -->
				<p><a class="cta" href="#">Coming soon</a></p>
			</section>
			<section class="features">
				{features.map((f) => (
					<div>
						<h3>{f.title}</h3>
						<p>{f.text}</p>
					</div>
				))}
			</section>
		</main>
		<Footer />
	</body>
</html>
<style>
	.hero {
		text-align: center;
		padding: 2em 0;
	}
	.cta {
		display: inline-block;
		padding: 0.5em 1.5em;
		background: var(--accent);
		color: white;
		border-radius: 999px;
		text-decoration: none;
	}
	.features {
		display: grid;
		gap: 1.5em;
		grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
	}
	.features h3 {
		margin-bottom: 0.25em;
	}
</style>
