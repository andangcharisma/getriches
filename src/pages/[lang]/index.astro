---
import Base from '../../layouts/Base.astro';
import { locales, type Locale, ui } from '../../i18n/ui';

export function getStaticPaths() {
	return locales.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Locale;
const t = ui[lang];

const icons: Record<string, string> = {
	track: 'M12 8v8M8 12h8M21 12a9 9 0 11-18 0 9 9 0 0118 0z',
	budget: 'M12 3v9h9a9 9 0 11-9-9zM16 3.6A9 9 0 0120.4 8H16z',
	goals: 'M12 21a9 9 0 100-18 9 9 0 000 18zM12 16a4 4 0 100-8 4 4 0 000 8zM12 12h.01',
};
---

<Base lang={lang} title={`Riches — ${t.h1a} ${t.h1b}`}>
	<main>
		<section class="hero">
			<div>
				<span class="tag tag-accent">{t.tagline}</span>
				<h1>{t.h1a} <span class="grad">{t.h1b}</span></h1>
				<p class="sub">{t.sub}</p>
				<div class="actions">
					<!-- TODO: point to the real store links once the app is published -->
					<a class="btn btn-brand" href="#download">{t.start}</a>
					<a class="btn btn-secondary" href={`/${lang}/blog/`}>{t.readDev}</a>
				</div>
			</div>
			<div class="phone-wrap">
				<!-- Placeholder mock — replace with a real app screenshot -->
				<div class="phone" aria-hidden="true">
					<div class="muted">{t.balance}</div>
					<div class="amount">Rp 12.480.000</div>
					<div class="budget">
						<div class="small">{t.budgetLeft}</div>
						<div class="big">Rp 3.2 jt</div>
						<div class="bar"><div class="fill"></div></div>
					</div>
					{t.tx.map(([name, amt]) => (
						<div class="row"><span>{name}</span><b>{amt}</b></div>
					))}
				</div>
			</div>
		</section>

		<section class="features">
			<h2>{t.featTitle}</h2>
			<div class="grid">
				{t.features.map((f) => (
					<div class="card card-hoverable">
						<div class="icon">
							<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#c4b5fd" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
								<path d={icons[f.icon]} />
							</svg>
						</div>
						<div class="card-kicker">{f.kicker}</div>
						<div class="card-title">{f.title}</div>
						<p class="card-body">{f.body}</p>
					</div>
				))}
			</div>
		</section>

		<section id="download" class="cta">
			<h2>{t.ctaTitle}</h2>
			<p>{t.ctaSub}</p>
			<a class="btn btn-brand" href="#download">{t.start}</a>
		</section>
	</main>
</Base>

<style>
	.hero {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 360px), 1fr));
		gap: 56px;
		align-items: center;
		padding: clamp(40px, 8vw, 96px) var(--page-pad) clamp(48px, 6vw, 80px);
		background:
			radial-gradient(60% 80% at 80% 30%, rgba(124, 58, 237, 0.35), transparent 70%),
			radial-gradient(40% 50% at 95% 80%, rgba(236, 72, 153, 0.25), transparent 70%);
	}
	h1 {
		font-size: clamp(44px, 7vw, 72px);
		line-height: 1.1;
		font-weight: 800;
		letter-spacing: -0.03em;
		margin: 20px 0;
	}
	.grad {
		background: linear-gradient(90deg, #7c3aed, #ec4899);
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
	}
	.sub {
		font-size: clamp(17px, 2vw, 20px);
		line-height: 1.6;
		color: var(--color-text-secondary);
		max-width: 520px;
		margin-bottom: 36px;
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
	}
	.phone-wrap {
		display: flex;
		justify-content: center;
	}
	.phone {
		width: 300px;
		max-width: 100%;
		min-height: 560px;
		border-radius: 44px;
		border: 8px solid var(--color-surface-3);
		background: var(--color-surface);
		box-shadow: 0 0 80px rgba(124, 58, 237, 0.5);
		padding: 28px 20px;
		display: flex;
		flex-direction: column;
		gap: 16px;
	}
	.muted {
		font-size: 13px;
		color: var(--color-text-muted);
	}
	.amount {
		font-size: 38px;
		font-weight: 800;
		line-height: 1.1;
	}
	.budget {
		padding: 18px;
		border-radius: 16px;
		background: linear-gradient(135deg, #7c3aed, #ec4899);
	}
	.small {
		font-size: 12px;
	}
	.big {
		font-size: 24px;
		font-weight: 700;
		margin: 4px 0 10px;
	}
	.bar {
		height: 6px;
		border-radius: 3px;
		background: rgba(255, 255, 255, 0.3);
	}
	.fill {
		width: 62%;
		height: 6px;
		border-radius: 3px;
		background: #fff;
	}
	.row {
		display: flex;
		justify-content: space-between;
		gap: 8px;
		padding: 12px 14px;
		border-radius: 12px;
		background: var(--color-surface-2);
		font-size: 14px;
	}
	.row b {
		font-weight: 600;
	}
	.features {
		padding: 24px var(--page-pad) 80px;
	}
	.features h2 {
		font-size: clamp(28px, 4vw, 40px);
		font-weight: 700;
		margin-bottom: 40px;
	}
	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
		gap: 24px;
	}
	.icon {
		width: 48px;
		height: 48px;
		border-radius: 14px;
		display: flex;
		align-items: center;
		justify-content: center;
		margin-bottom: 16px;
		background: linear-gradient(135deg, rgba(124, 58, 237, 0.35), rgba(236, 72, 153, 0.2));
		border: 1px solid rgba(167, 139, 250, 0.3);
	}
	.cta {
		margin: 0 var(--page-pad) 80px;
		padding: clamp(36px, 6vw, 72px) 24px;
		border-radius: 24px;
		text-align: center;
		background: linear-gradient(135deg, rgba(124, 58, 237, 0.3), rgba(236, 72, 153, 0.2));
		border: 1px solid var(--color-divider);
	}
	.cta h2 {
		font-size: clamp(28px, 4.5vw, 44px);
		font-weight: 800;
	}
	.cta p {
		font-size: 18px;
		color: var(--color-text-secondary);
		margin-bottom: 24px;
	}
</style>
