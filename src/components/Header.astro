---
import { type Locale, locales, ui } from '../i18n/ui';

interface Props {
	lang: Locale;
}
const { lang } = Astro.props;
const t = ui[lang];
const path = Astro.url.pathname;
const onBlog = path.startsWith(`/${lang}/blog`);
const switchTo = (l: Locale) => path.replace(/^\/(id|en)(?=\/|$)/, `/${l}`);
---

<header>
	<a class="brand" href={`/${lang}/`}>Riches</a>
	<nav class="pages">
		<a href={`/${lang}/`} class:list={{ active: !onBlog }}>{t.navApp}</a>
		<a href={`/${lang}/blog/`} class:list={{ active: onBlog }}>{t.navBlog}</a>
	</nav>
	<div class="right">
	<div class="lang" role="group" aria-label="Language">
		{locales.map((l) => (
			<a href={switchTo(l)} class:list={{ active: l === lang }} hreflang={l} aria-current={l === lang ? 'true' : undefined}>
				{l.toUpperCase()}
			</a>
		))}
	</div>
	<a class="btn btn-primary" href={`/${lang}/#download`}>{t.getApp}</a>
	</div>
</header>

<style>
	header {
		position: sticky;
		top: 0;
		z-index: 5;
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		gap: 12px 16px;
		padding: 16px var(--page-pad);
		background: rgba(15, 10, 26, 0.9);
		backdrop-filter: blur(12px);
		border-bottom: 1px solid var(--color-divider);
	}
	.brand {
		font-size: 26px;
		font-weight: 800;
		letter-spacing: -0.02em;
		color: var(--color-text);
	}
	.pages {
		display: flex;
		gap: 4px;
		justify-self: center;
	}
	.right {
		display: flex;
		align-items: center;
		justify-content: flex-end;
		gap: 12px 16px;
	}
	.pages a {
		padding: 8px 18px;
		border-radius: 999px;
		color: var(--color-text-secondary);
		font-weight: 500;
		background: transparent;
	}
	.pages a.active {
		background: rgba(124, 58, 237, 0.35);
		color: var(--color-text);
	}
	.lang {
		display: inline-flex;
		padding: 3px;
		background: var(--color-surface);
		border: 1px solid var(--color-divider);
		border-radius: 999px;
	}
	.lang a {
		padding: 6px 12px;
		border-radius: 999px;
		font-size: 13px;
		font-weight: 700;
		color: var(--color-text-secondary);
	}
	.lang a.active {
		background: rgba(124, 58, 237, 0.45);
		color: var(--color-text);
	}
	@media (max-width: 700px) {
		header {
			grid-template-columns: 1fr auto;
		}
		.pages {
			grid-column: 1 / -1;
			grid-row: 2;
		}
	}
</style>
